{
  "manifest_version": 3,
  "name": "Stihl Parts Collector",
  "version": "1.0",
  "description": "Collect part numbers from Stihl IPL pages and export to CSV.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://ssc.stihl.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stihl Parts Collector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://ssc.stihl.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
